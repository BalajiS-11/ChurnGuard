# Database
DATABASE_URL=sqlite:///./churnguard.db
# PostgreSQL for docker: postgresql://churn:churn@db:5432/churnguard

# Security
SECRET_KEY=churnguard_super_secret_jwt_key_change_in_production_2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ML Artifacts
MODEL_PATH=ml/artifacts/model_v1.joblib
METADATA_PATH=ml/artifacts/metadata.json

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend public env (used in Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
